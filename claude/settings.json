{
  "permissions": {
    "allow": [
      "Bash(/Users/rchatrath/.claude/plugins/marketplaces/claude-code-plugins/plugins/ralph-wiggum/**)",
      "Bash(/Users/rchatrath/.claude/plugins/marketplaces/claude-code-plugins/plugins/ralph-wiggum/scripts/*.sh *)",
      "Bash(pnpm run --silent grafana-query*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
