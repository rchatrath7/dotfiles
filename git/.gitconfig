[user]
	name = Rakesh Chatrath
	email = rakesh@socket.dev
	signingkey = ~/.ssh/id_ed25519.pub
	signkey = ~/.ssh/id_ed25519.pub
[core]
	excludesfile = ~/.gitignore
[alias]
    graph = log --graph --decorate --oneline
    opush = push -u origin head
    ppush = push -u origin +head
    staging = push origin +head:staging
    co = checkout
    op = opush
    pp = ppush
    st = staging
    rb = !git fetch && git rebase -i origin/master && git submodule update --rebase
    pull = git pull && git submodule update 
[pull]
	ff = only
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[include]
	path = ~/.config/dev/gitconfig
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[merge]
	tool = nvimdiff
[gpg]
	format = ssh
	program = /opt/homebrew/bin/gpg
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
